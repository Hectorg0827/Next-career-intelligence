# Backend environment variables template
# Copy this file to .env and fill in your actual values

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/next_career_db

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4

# O*NET Web Services
ONET_API_KEY=your-onet-api-key-here
ONET_BASE_URL=https://services.onetcenter.org/ws

# Coursera API (optional)
COURSERA_API_KEY=your-coursera-api-key-here
COURSERA_BASE_URL=https://api.coursera.org/api

# LinkedIn API (optional - Phase 2)
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Neo4j (optional - Phase 2)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Security
SECRET_KEY=your-secret-key-change-in-production-use-python-secrets-token-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# CORS - Add your frontend URL
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","https://your-production-domain.com"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
