# ========================================
# NEXT Career Intelligence - Environment Variables
# Copy to .env and fill in your values
# ========================================

# App Configuration
APP_NAME="NEXT Career Intelligence"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Database (Legacy)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/next_career_db"

# ========================================
# SUPABASE (Primary Database)
# ========================================
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_anon_key_here"
SUPABASE_SERVICE_KEY="your_service_key_here"

# ========================================
# AI / LLM
# ========================================
GEMINI_API_KEY="your_gemini_api_key_here"

# ========================================
# FIREBASE AUTHENTICATION
# ========================================
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
GOOGLE_CLOUD_PROJECT=""

# ========================================
# STRIPE SUBSCRIPTION MANAGEMENT
# ========================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PREMIUM_MONTHLY="price_..."
STRIPE_PRICE_PREMIUM_YEARLY="price_..."
STRIPE_PRICE_ENTERPRISE_MONTHLY="price_..."
STRIPE_PRICE_ENTERPRISE_YEARLY="price_..."

# ========================================
# REDIS CACHING & RATE LIMITING
# ========================================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"

# ========================================
# EXTERNAL APIs
# ========================================
ONET_API_KEY=""
ONET_BASE_URL="https://services.onetcenter.org/ws"
COURSERA_API_KEY=""
COURSERA_BASE_URL="https://api.coursera.org/api"
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# ========================================
# SECURITY & CORS
# ========================================
SECRET_KEY="your-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:3001"]'
FRONTEND_URL="http://localhost:3000"

# ========================================
# PERFORMANCE & MONITORING
# ========================================
LOG_LEVEL="INFO"

# Sentry Error Monitoring (optional)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE=0.1

# Compression
ENABLE_COMPRESSION=true
COMPRESSION_MIN_SIZE=1024

# Request Limits
MAX_REQUEST_SIZE=10485760  # 10MB in bytes

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PREMIUM_PER_MINUTE=300

# ========================================
# FILE UPLOAD
# ========================================
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES="pdf,docx,txt"
