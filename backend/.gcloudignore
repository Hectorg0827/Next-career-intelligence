# .gcloudignore - Files to exclude from Google Cloud Build
# Similar to .gitignore but for gcloud deployments

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv

# Testing
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local environment
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Database
*.db
*.sqlite

# Documentation
docs/
*.md
!README.md

# Tests
tests/
test_*.py

# Git
.git/
.gitignore

# CI/CD (if not using for Cloud Build)
.github/
.gitlab-ci.yml

# Node (if any)
node_modules/

# Temporary files
tmp/
temp/
*.tmp
